{
  "name": "js-calculator-mac",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "main": "electron.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start-desktop": "electron .",
    "build-mac": "vite build && electron-builder --mac"
  },
  "build": {
    "appId": "com.yourname.calculator",
    "productName": "JS Calculator",
    "mac": {
      "target": "dmg"
    },
    "directories": {
      "output": "mac-release"
    }
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.13.3",
    "vite": "^5.0.0"
  }
}